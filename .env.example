# ─── Aleta Planet UnifyApi (Visa / Mastercard) ───────────────────────────────
# Sandbox host (no protocol). Production: pay.aletapay.com
ALETA_SERVER=paysit.aletapay.com

# Merchant code (client-id) and MID (sub-client-id) issued by Aleta Planet.
# For Visa/Mastercard use the Visa/Master MID (the Postman collection's vmMid).
ALETA_MERCHANT_CODE=your_merchant_code
ALETA_MID=your_visa_master_mid

# Card scheme for the /order request header. VISA or MASTERCARD.
# The hosted page accepts both Visa and Mastercard regardless of this value.
ALETA_SERVICE=VISA

# Your RSA private key (PKCS#8). Paste the base64 body on ONE line, WITHOUT the
# "-----BEGIN/END PRIVATE KEY-----" lines (the app adds PEM armor automatically).
# Generate:  openssl genrsa -out private-key.pem 2048
#            openssl pkcs8 -topk8 -nocrypt -in private-key.pem -out pkcs8.pem
# Send the matching PUBLIC key to cs@aletaplanet.com (see spec §3 Preparations).
ALETA_PRIVATE_KEY=MIIEvQIBADAN...your_base64_pkcs8_private_key...

# Aleta Planet's PUBLIC key (base64 body, one line). Optional but recommended —
# used to verify webhook / redirect signatures. See spec §3 for the sample key.
ALETA_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...

# ─── PayNow (dynamic QR) ─────────────────────────────────────────────────────
# Separate channel: reuses ALETA_MERCHANT_CODE + ALETA_PRIVATE_KEY + ALETA_SERVER
# but has its own MID and public key. Leave ALETA_PAYNOW_MID unset to disable PayNow.
ALETA_PAYNOW_MID=
ALETA_PAYNOW_PUBLIC_KEY=
# Header "service" value for PayNow requests (confirm against the PayNow doc).
ALETA_PAYNOW_SERVICE=ALETAPLANET
# API paths (override if the PayNow doc differs from these defaults).
ALETA_PAYNOW_GENQRC_PATH=/qrc/v1/paynow/genQrc
ALETA_PAYNOW_INQUIRY_PATH=/qrc/v1/paynow/inquiry

# ─── Database (gift card storage + redemption) ──────────────────────────────
# Postgres connection string. On Railway, add a Postgres plugin and reference it,
# e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}. Migrations run automatically on boot.
DATABASE_URL=postgres://user:password@host:5432/giftacard

# ─── Redemption API (handed to the Aleta Adventure app developers) ───────────
# Shared secret the app sends as the `x-api-key` header to /api/redeem. Generate a
# strong random value, e.g.  openssl rand -hex 32
REDEEM_API_KEY=replace_with_a_long_random_secret

# ─── Admin dashboard ─────────────────────────────────────────────────────────
# Password for the /admin login. The session cookie is signed with a key derived
# from this value. Use something strong:  openssl rand -hex 24
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ─── Email (gift + receipt) ──────────────────────────────────────────────────
# Resend HTTP API. If unset, emails are logged to the console instead of sent.
# EMAIL_FROM must be a verified Resend sender, e.g. "Aleta Gifts <gifts@yourdomain>".
RESEND_API_KEY=
EMAIL_FROM=

# ─── Aleta Adventure app store links (shown on success page + emails) ─────────
APP_STORE_URL=https://apps.apple.com/sg/app/aleta-adventure
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.aletaplanet.adventure

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL used to build frontUrl (redirect) and webhook (notification).
# On Railway this is auto-detected from RAILWAY_PUBLIC_DOMAIN; set explicitly to
# override (must be HTTPS and publicly reachable for the webhook to fire).
# APP_BASE_URL=https://your-app.up.railway.app
