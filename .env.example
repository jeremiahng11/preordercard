# ─── Aleta Planet UnifyApi (Visa / Mastercard) ───────────────────────────────
# Sandbox host (no protocol). Production: pay.aletapay.com
ALETA_SERVER=paysit.aletapay.com

# Merchant code (client-id) and MID (sub-client-id) issued by Aleta Planet.
# For Visa/Mastercard use the Visa/Master MID (the Postman collection's vmMid).
ALETA_MERCHANT_CODE=your_merchant_code
ALETA_MID=your_visa_master_mid

# Card scheme for the /order request header. VISA or MASTERCARD.
# The hosted page accepts both Visa and Mastercard regardless of this value.
ALETA_SERVICE=VISA

# Your RSA private key (PKCS#8). Paste the base64 body on ONE line, WITHOUT the
# "-----BEGIN/END PRIVATE KEY-----" lines (the app adds PEM armor automatically).
# Generate:  openssl genrsa -out private-key.pem 2048
#            openssl pkcs8 -topk8 -nocrypt -in private-key.pem -out pkcs8.pem
# Send the matching PUBLIC key to cs@aletaplanet.com (see spec §3 Preparations).
ALETA_PRIVATE_KEY=MIIEvQIBADAN...your_base64_pkcs8_private_key...

# Aleta Planet's PUBLIC key (base64 body, one line). Optional but recommended —
# used to verify webhook / redirect signatures. See spec §3 for the sample key.
ALETA_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL used to build frontUrl (redirect) and webhook (notification).
# On Railway this is auto-detected from RAILWAY_PUBLIC_DOMAIN; set explicitly to
# override (must be HTTPS and publicly reachable for the webhook to fire).
# APP_BASE_URL=https://your-app.up.railway.app
